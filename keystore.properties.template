# Sustenance Signing Configuration Template
# Copy this file to 'keystore.properties' (which is gitignored) and fill in your values.
# Alternatively, set the corresponding environment variables in your CI/CD environment.

# Path to your .jks or .keystore file
storeFile=/path/to/your/release.keystore

# Keystore password
storePassword=your_keystore_password

# Key alias name
keyAlias=your_key_alias

# Key password
keyPassword=your_key_password

# Environment Variables equivalent:
# SUSTENANCE_STORE_FILE
# SUSTENANCE_STORE_PASSWORD
# SUSTENANCE_KEY_ALIAS
# SUSTENANCE_KEY_PASSWORD
