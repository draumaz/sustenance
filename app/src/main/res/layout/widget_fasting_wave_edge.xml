<?xml version="1.0" encoding="utf-8"?>
<!-- Hosts the fill's animated wavy edge in FastingWidget. A ProgressBar because it's one of the
     few RemoteViews-safe views that starts an Animatable drawable by itself, and restarts it
     whenever the widget becomes visible again. The default ProgressBar style caps it at 48dp, so
     the size limits are lifted to let it span the widget's height, and indeterminateOnly stays
     false because an indeterminate-only ProgressBar keeps the drawable's aspect ratio (a 120dp
     sliver centred in the strip) instead of stretching it to fill. -->
<ProgressBar xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fasting_wave_edge"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:indeterminate="true"
    android:indeterminateDrawable="@drawable/widget_fasting_wave"
    android:indeterminateOnly="false"
    android:maxWidth="2000dp"
    android:maxHeight="2000dp"
    android:minWidth="0dp"
    android:minHeight="0dp" />
