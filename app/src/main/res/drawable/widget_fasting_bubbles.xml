                <path
                    android:fillAlpha="0.32"
                    android:fillColor="@color/widget_fasting_fill"
                    android:pathData="M -1,-40 L 10.85,-40 C 10.85,-32.72 7.75,-27.28 7.75,-20 C 7.75,-12.72 10.85,-7.28 10.85,0 C 10.85,7.28 7.75,12.72 7.75,20 C 7.75,27.28 10.85,32.72 10.85,40 C 10.85,47.28 7.75,52.72 7.75,60 C 7.75,67.28 10.85,72.72 10.85,80 C 10.85,87.28 7.75,92.72 7.75,100 C 7.75,107.28 10.85,112.72 10.85,120 C 10.85,127.28 7.75,132.72 7.75,140 C 7.75,147.28 10.85,152.72 10.85,160 L -1,160 Z" />
            </group>

            <!-- Primary liquid meniscus -->
