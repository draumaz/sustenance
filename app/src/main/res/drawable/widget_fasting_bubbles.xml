                <path
                    android:name="i1_path"
                    android:fillAlpha="0"
                    android:fillColor="@color/widget_fasting_track"
                    android:pathData="M -1.4,0 A 1.4,1.4 0 1,0 1.4,0 A 1.4,1.4 0 1,0 -1.4,0 Z" />
            </group>
            <group android:name="i2_group">
