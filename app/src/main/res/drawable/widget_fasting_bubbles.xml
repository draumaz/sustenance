                    android:pathData="M -1,-60 L 6.65,-60 C 6.65,-49.07 9.35,-40.93 9.35,-30 C 9.35,-19.07 6.65,-10.93 6.65,0 C 6.65,10.93 9.35,19.07 9.35,30 C 9.35,40.93 6.65,49.07 6.65,60 C 6.65,70.93 9.35,79.07 9.35,90 C 9.35,100.93 6.65,109.07 6.65,120 C 6.65,130.93 9.35,139.07 9.35,150 C 9.35,160.93 6.65,169.07 6.65,180 L -1,180 Z" />
            </group>

            <!-- Subtle inner shimmer bubbles rising just inside the liquid edge -->
