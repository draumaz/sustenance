<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose drives all UI; this base theme just removes the action bar. -->
    <style name="Theme.Sustenance" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>

    <style name="Theme.Sustenance.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Sustenance</item>
    </style>
    <style name="WidgetPreviewTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/widget_preview_tile</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">6dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_preview_on_tile</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
